{
  "name": "hearthvale",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A cosy 3D browser god game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "smoke": "node scripts/smoke.mjs",
    "balance": "vitest run --config vitest.balance.config.ts",
    "perf": "node scripts/perf.mjs",
    "petshots": "node scripts/petshots.mjs",
    "buildshots": "node scripts/buildshots.mjs",
    "voicesheet": "node scripts/voicesheet.mjs",
    "voices": "node scripts/voices.mjs",
    "voicepreview": "node scripts/voicepreview.mjs",
    "vibeshots": "node scripts/vibeshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "three": "^0.187.0"
  }
}
